<!DOCTYPE html>
<html lang="ja">
<head>
<!-- Google AdSense -->
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1294748320155117"
     crossorigin="anonymous"></script>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}｜ブログ | Poker MANIA</title>
<meta name="description" content="{{ description or title }}">
<link rel="canonical" href="https://poker-mania.jp/blog/{{ slug }}/">
<meta property="og:type" content="article">
<meta property="og:url" content="https://poker-mania.jp/blog/{{ slug }}/">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description or title }}">
<meta property="og:site_name" content="Poker MANIA">
<meta property="og:locale" content="ja_JP">
<style>
*{box-sizing:border-box;margin:0;padding:0;}
html,body{background:#ffffff;font-family:-apple-system,"Hiragino Kaku Gothic ProN",Meiryo,sans-serif;color:#33333a;min-height:100vh;line-height:1.9;}
.header{position:sticky;top:0;z-index:50;background:#ffffff;border-bottom:1px solid #e5ece8;padding:12px 16px;display:flex;align-items:center;gap:10px;}
.header-title{font-size:16px;font-weight:700;color:#1b5e3f;}
.back-link{background:#edf3ef;border-radius:8px;color:#77726a;font-size:12px;padding:6px 10px;text-decoration:none;}
.hero{padding:26px 16px 18px;border-bottom:1px solid #edf3ef;}
.hero-meta{display:flex;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap;}
.hero-date{font-size:11px;color:#9a958c;letter-spacing:0.05em;}
.hero-tag{font-size:10px;font-weight:700;color:#1b5e3f;background:#e7f1eb;border:1px solid #bfdccc;border-radius:12px;padding:2px 9px;}
.hero-title{font-size:23px;font-weight:800;color:#2b2b30;line-height:1.4;}
.content{max-width:720px;margin:0 auto;padding:8px 16px 40px;}

/* Markdownから生成される本文のスタイル */
.post-body{font-size:17px;color:#3c3c44;line-height:1.85;}
.post-body p{margin:0 0 8px;}
.post-body strong{color:#1f1f24;font-weight:700;}
.post-body a{color:#1b5e3f;text-decoration:underline;word-break:break-all;}
/* 見出し（サイズ＝文字の大きさ／緑テンプレート）*/
.post-body h1{font-size:22px;font-weight:800;color:#1b5e3f;margin:26px 0 12px;line-height:1.35;}
.post-body h2{font-size:19px;font-weight:800;color:#1b5e3f;margin:26px 0 12px;padding-bottom:8px;border-bottom:2px solid #cfe6d9;}
.post-body h3{font-size:16px;font-weight:800;color:#2b2b30;margin:18px 0 6px;}
.post-body h4{font-size:14px;font-weight:800;color:#2f7d57;margin:16px 0 6px;}
.post-body ul,.post-body ol{margin:0 0 10px;padding-left:1.4em;}
.post-body li{margin-bottom:4px;}
.post-body img{max-width:100%;height:auto;border-radius:10px;margin:12px 0;display:block;}
/* 画像サイズ選択（管理画面の「画像（サイズ選択）」で入る） */
.post-body img.pimg{margin:14px auto;}
.post-body img.pimg-300{max-width:300px;width:100%;}
.post-body img.pimg-480{max-width:480px;width:100%;}
.post-body img.pimg-680{max-width:680px;width:100%;}
.post-body img.pimg-full{max-width:100%;width:100%;}
/* 緑の囲みボックス（管理画面の「囲みボックス（緑）」で入る） */
.post-body .pbox{background:#f1f7f3;border:1px solid #dcebe2;border-left:3px solid #2f8a5b;border-radius:8px;padding:10px 14px;margin:10px 0;font-size:13.5px;color:#55524b;line-height:1.85;}
/* 文字サイズ・色（管理画面の「テキスト（サイズ・色）」で入る）*/
.post-body .ptxt{margin:0 0 10px;line-height:1.5;}
.post-body .ptext-lg{font-size:18px;font-weight:700;color:#2b2b30;margin:0 0 10px;line-height:1.7;}
.post-body .ptext-sm{font-size:13px;color:#6f6a61;margin:0 0 10px;line-height:1.7;}
.post-body blockquote{margin:14px 0;padding:10px 14px;background:#f1f7f3;border-left:3px solid #2f8a5b;border-radius:8px;color:#55524b;}
.post-body hr{border:none;border-top:1px solid #ece7d9;margin:22px 0;}
.post-body table{width:100%;border-collapse:collapse;margin:12px 0;font-size:13.5px;}
.post-body th{background:#e7f1eb;color:#1b5e3f;text-align:left;padding:8px 10px;}
.post-body td{padding:8px 10px;border-bottom:1px solid #e9e5da;}

.ad-wrap{max-width:728px;margin:28px auto;padding:0 4px;box-sizing:border-box;text-align:center;}
.ad-label{font-size:10px;color:#b3aea3;letter-spacing:1px;margin-bottom:4px;}
.back-to-blog{display:inline-block;margin-top:18px;color:#1b5e3f;font-size:13px;text-decoration:none;font-weight:700;}
.site-footer{border-top:1px solid #e5ece8;margin-top:20px;padding:24px 16px 40px;text-align:center;}
.site-footer a{color:#1b5e3f;font-size:12px;text-decoration:none;margin:0 6px;}
.site-footer .copy{display:block;margin-top:12px;font-size:11px;color:#b3aea3;}
</style>
</head>
<body>
<div class="header">
  <a href="/blog/" class="back-link">← ブログ一覧</a>
  <div class="header-title">📝 ブログ</div>
</div>

<div class="hero">
  <div class="hero-meta">
    <span class="hero-date">{{ date | ymd }}</span>
    <span class="hero-tag">{{ tag }}</span>
  </div>
  <h1 class="hero-title">{{ title }}</h1>
</div>

<div class="content">

  <article class="post-body">
{{ content | safe }}
  </article>

  <div class="ad-wrap">
    <div class="ad-label">スポンサーリンク</div>
    <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-1294748320155117" data-ad-slot="2184231625" data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>

  <a class="back-to-blog" href="/blog/">← ブログ一覧に戻る</a>

</div>

<footer class="site-footer">
  <a href="/index.html">ホーム</a>·<a href="/guide.html">ポーカー講座</a>·<a href="/blog/">ブログ</a>·<a href="/privacy.html">プライバシーポリシー</a>·<a href="/contact.html">お問い合わせ</a>·<a href="/about.html">運営者情報</a>
  <span class="copy">© 2026 Poker MANIA</span>
</footer>

</body>
</html>
